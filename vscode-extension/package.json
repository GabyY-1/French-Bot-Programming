{
  "name": "fbp-language",
  "displayName": "FBP Language Support",
  "description": "Coloration syntaxique, autocomplétion, détection des erreurs et thème d'icônes FBP.",
  "version": "1.2.3",
  "publisher": "gabyy1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "main": "./extension.js",
  "categories": ["Programming Languages", "Themes"],
  "extensionKind": ["workspace"],
  "activationEvents": ["onLanguage:fbp"],
  "contributes": {
    "languages": [
      {
        "id": "fbp",
        "aliases": ["FBP", "fbp"],
        "extensions": [".fbp"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fbp",
        "scopeName": "source.fbp",
        "path": "./syntaxes/fbp.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "fbp-file-icons",
        "label": "FBP File Icons",
        "path": "./themes/fbp-icon-theme.json"
      }
    ]
  }
}
