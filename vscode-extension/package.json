{
  "name": "fbp-language",
  "displayName": "FBP Language Support",
  "description": "Coloration syntaxique, reconnaissance des fichiers .fbp et thème d'icônes FBP.",
  "version": "1.1.9",
  "publisher": "gabyy1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "languages": [
      {
        "id": "fbp",
        "aliases": [
          "FBP",
          "fbp"
        ],
        "extensions": [
          ".fbp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fbp",
        "scopeName": "source.fbp",
        "path": "./syntaxes/fbp.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "fbp-file-icons",
        "label": "FBP File Icons",
        "path": "./themes/fbp-icon-theme.json"
      }
    ]
  }
}
