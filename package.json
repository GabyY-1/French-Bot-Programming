{
  "name": "fbp-language",
  "displayName": "FBP - French Bot Programming",
  "description": "Langage FBP avec compilateur, commandes Discord et support VS Code.",
  "version": "1.3.0",
  "type": "commonjs",
  "main": "dist/compiler.js",
  "bin": {
    "fbp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "syntaxes/",
    "assets/",
    "themes/",
    "vscode-extension/",
    "language-configuration.json",
    "package.json",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GabyY-1/French-Bot-Programming.git"
  },
  "homepage": "https://github.com/GabyY-1/French-Bot-Programming#readme",
  "bugs": {
    "url": "https://github.com/GabyY-1/French-Bot-Programming/issues"
  },
  "keywords": [
    "fbp",
    "language",
    "interpreter",
    "french",
    "cli",
    "discord",
    "slash-commands",
    "bot",
    "vscode-extension"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7"
  },
  "contributes": {
    "languages": [
      {
        "id": "fbp",
        "aliases": [
          "FBP",
          "fbp"
        ],
        "extensions": [
          ".fbp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "fbp",
        "scopeName": "source.fbp",
        "path": "./syntaxes/fbp.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "fbp-file-icons",
        "label": "FBP File Icons",
        "path": "./themes/fbp-icon-theme.json"
      }
    ]
  },
  "license": "Apache-2.0"
}
