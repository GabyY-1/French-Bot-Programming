{
  "name": "fbp-language",
  "displayName": "FBP - French Bot Programming",
  "description": "Langage FBP avec options slash Discord, choix prédéfinis et embeds dynamiques.",
  "version": "1.1.6",
  "type": "commonjs",
  "main": "dist/compiler.js",
  "bin": {
    "fbp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/GabyY-1/French-Bot-Programming.git"
  },
  "homepage": "https://github.com/GabyY-1/French-Bot-Programming#readme",
  "bugs": {
    "url": "https://github.com/GabyY-1/French-Bot-Programming/issues"
  },
  "keywords": [
    "fbp",
    "language",
    "interpreter",
    "french",
    "cli",
    "discord",
    "slash-commands",
    "bot"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm test",
    "start": "node dist/cli.js",
    "dev": "ts-node src/cli.ts",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "discord.js": "^14.19.3",
    "dotenv": "^16.4.7"
  }
}
